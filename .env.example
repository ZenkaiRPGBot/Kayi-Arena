# Telegram & Web Health Server
BOT_TOKEN=
BOT_USERNAME=KayiArenaBot
DROP_PENDING_UPDATES=true
HOST=0.0.0.0
PORT=10000
# Transport: polling (default) or webhook (recommended for sleeping free Render Web Services)
TRANSPORT_MODE=polling
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

# Owner & Admin Authorization (comma-separated numeric Telegram user IDs)
OWNER_ID=
ADMIN_IDS=
LOG_CHANNEL_ID=

# Kayi Bots Ecosystem Links
DEVELOPER_URL=https://t.me/qouba
UPDATES_URL=https://t.me/KayiBots
SUPPORT_URL=https://t.me/KayiBots

# Durable Storage (point to persistent disk mount such as /var/data in production)
ARENA_DB_PATH=data/kayi_arena.sqlite3
ARENA_STATE_DB_PATH=data/kayi_arena_state.sqlite3
RESTART_STATE_PATH=
ARENA_DATASET_KIND=production

# Optional branding media (Telegram file_id or HTTPS URL)
HOME_BANNER_REF=
CARD_BACK_REF=

# Logging
LOG_LEVEL=INFO
